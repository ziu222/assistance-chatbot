  "cards": [
    {
      "dot": "cyan",
      "title": "Edge & Realtime",
      "items": [
        "Isolated iframe widget with signed Bearer JWT and frame-ancestors allowlist",
        "Admin inbox authenticates via DB-backed __Host-sid cookies",
        "SSE streams carry ID-only signals; REST remains the source of truth"
      ]
    },
    {
      "dot": "emerald",
      "title": "Transactional Core",
      "items": [
        "Inbound messages stored exactly once with gapless per-conversation sequence",
        "Outbox events committed in the same PostgreSQL transaction as messages",
        "Tenant isolation enforced server-side with composite (tenant_id, id) keys"
      ]
    },
    {
      "dot": "rose",
      "title": "Safety Boundary",
      "items": [
        "AgentRunner writes only drafts and never imports outbound or writes messages",
        "AutopilotStage enforces a pure fail-closed send gate before outbound.send_ai_reply",
        "Shadow Judge and Learning Eval Gate run asynchronously with per-tenant cost caps"
      ]
    }
  ]
