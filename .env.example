POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:54329/atlas
REDIS_URL=redis://localhost:6379/0
POSTGRES_PORT=54329
# Origin phục vụ trang iframe widget (/w/{key}); widget gọi API từ origin này.
PUBLIC_ORIGIN=http://localhost:8000
# JSON {"kid": "secret"}, mỗi secret >= 32 byte. Sinh: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBCHAT_TOKEN_SECRETS={"k1": "thay-bang-chuoi-ngau-nhien-it-nhat-32-byte"}
WEBCHAT_TOKEN_KID=k1
# Origin của admin inbox (kiểm tra CSRF cho POST của nhân viên).
STAFF_ORIGIN=http://localhost:5173
# LLM (ADR-0015). Key trong backend/.env, KHÔNG commit. Thiếu key thì provider đó bị bỏ khỏi route.
CLAUDE_API_KEY=
OPENAI_API_KEY=
# Rỗng = API chính thức. Gateway thử nghiệm: đặt URL gateway ở đây, không đổi code.
LLM_BASE_URL=
# Tắt tạm provider đang sập, vd "anthropic" (phân tách bằng dấu phẩy).
LLM_DISABLED_PROVIDERS=
